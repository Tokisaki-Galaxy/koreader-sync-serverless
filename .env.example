# Set PASSWORD_PEPPER as Worker Secret:
# wrangler secret put PASSWORD_PEPPER
PASSWORD_PEPPER=please_use_a_long_random_secret
SESSION_TTL_HOURS=168
# SESSION_RENEW_WINDOW_HOURS defaults to half of SESSION_TTL_HOURS; set 0 to disable renewal.
# SESSION_RENEW_WINDOW_HOURS=84
ADMIN_TOKEN=please_set_a_strong_admin_token
RUNTIME_TARGET=cloudflare
DB_DRIVER=d1
# SQLITE_PATH is used when RUNTIME_TARGET=node and DB_DRIVER=sqlite
SQLITE_PATH=./data/koreader-sync.db
# MCP bearer token lifetime in hours, default 2160 (90 days)
# MCP_TOKEN_TTL_HOURS=2160
# Renewal window defaults to half the TTL; set 0 to disable sliding renewal.
# MCP_TOKEN_RENEW_WINDOW_HOURS=1080
# Comma-separated origin allowlist for cross-origin MCP calls
# MCP_ALLOWED_ORIGINS=https://claude.ai
